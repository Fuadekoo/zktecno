# ---- Server ----
PORT=4000
# 0.0.0.0 = reachable from other devices on your network; 127.0.0.1 = this computer only
HOST=0.0.0.0
NODE_ENV=development
# Only needed if something calls the API directly instead of through the Next.js proxy
CORS_ORIGIN=http://localhost:3000

# =====================================================================================
# NOTE: BioTime, devices (ZK_DEVICES), ADMS and SYNC settings below are read ONLY on the
# very first start, to fill the database. After that, change them in the dashboard:
# Settings (admin). Editing these lines has no effect any more.
# =====================================================================================

# ---- BioTime 8.5 server ----
# false = no BioTime server; sync uses only the devices and ADMS push
BIOTIME_ENABLED=true
# The address you open BioTime with in the browser
BIOTIME_URL=http://127.0.0.1:8090
# A BioTime system user (admin) with API access
BIOTIME_USERNAME=admin
BIOTIME_PASSWORD=admin
# jwt  -> /jwt-api-token-auth/ (header "JWT <token>")
# token -> /api-token-auth/    (header "Token <token>")
BIOTIME_AUTH_TYPE=jwt
BIOTIME_TIMEOUT_MS=20000

# ---- Direct device access (zkteco-js), optional ----
# Devices the backend also reads punches from directly over TCP (port 4370), alongside BioTime.
# Comma-separated "ip" or "ip:port" (default port 4370). Leave empty to turn it off.
#   ZK_DEVICES=192.168.1.201,192.168.1.202:4370
ZK_DEVICES=
ZK_TIMEOUT_MS=10000

# ---- ADMS push (devices send punches to this server) ----
# On each device: Menu > COMM. > Cloud Server Setting > Server Address = this PC's IP, Server Port = ADMS_PORT.
ADMS_ENABLED=false
ADMS_PORT=8082
# Forward every device request to BioTime, so BioTime keeps working. Set ADMS_FORWARD_URL to the
# server address/port the devices used BEFORE you changed them (empty = BIOTIME_URL).
ADMS_FORWARD=true
ADMS_FORWARD_URL=
ADMS_FORWARD_TIMEOUT_MS=15000
# Serial numbers allowed to save punches, comma-separated. Empty = devices BioTime knows. * = any device (testing).
ADMS_ALLOWED_SN=

# ---- PostgreSQL ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=zkteco_attendance
DB_CONNECTION_LIMIT=10
# The database and tables are created by Prisma migrations (npm run dev / npm start run them first).

# ---- Sync: BioTime -> MySQL ----
SYNC_ENABLED=true
# How often to pull new punches and device status (3600 = every hour). Minimum 60.
SYNC_INTERVAL_SECONDS=3600
# How often to refresh the employee list, in minutes
SYNC_EMPLOYEES_MINUTES=60
# On the very first run, import this many days of punch history
SYNC_INITIAL_DAYS=30
# Each run re-reads this many hours back, to catch punches that offline devices upload late
SYNC_LOOKBACK_HOURS=48

# ---- Dashboard login ----
# Used ONLY on first start to create the first admin account in MySQL (min 8 characters).
# After that, manage users on the Users page.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_JWT_SECRET=replace-with-a-long-random-secret
APP_SESSION_HOURS=12
