# ZK Attendance server: copy to backend/.env and fill in.
# Only what the server needs to start. Devices, ADMS push, sync and BioTime are set on the
# dashboard's Settings page and stored in the database.

# ---- Server ----
NODE_ENV=production
PORT=4000
# 0.0.0.0 = reachable from the network (devices pushing over ADMS, other PCs)
HOST=0.0.0.0
# Address(es) the dashboard is opened from, comma-separated (e.g. https://attendance.example.com)
CORS_ORIGIN=http://localhost:3000
# true only when the dashboard is served over HTTPS; with plain http:// sign-in needs false
COOKIE_SECURE=false

# ---- MySQL ----
# The database is created automatically if it doesn't exist (user needs CREATE rights).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zkteco_attendance
DB_CONNECTION_LIMIT=10

# ---- Security ----
# Signs login sessions. Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_JWT_SECRET=replace-with-a-long-random-string
APP_SESSION_HOURS=12

# ---- First admin account (only used when the database has no users yet) ----
ADMIN_USERNAME=admin
# At least 8 characters. Change it after the first sign-in (Users page).
ADMIN_PASSWORD=
