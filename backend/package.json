{
  "name": "zkteco-biotime-backend",
  "version": "1.0.0",
  "description": "Attendance server for ZKTeco devices (direct read + ADMS push, optional BioTime 8.5), MySQL via Prisma",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "prisma migrate deploy && tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "prisma migrate deploy && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:clear": "tsx src/db/seed.ts --clear",
    "user:reset-password": "tsx src/db/cli.ts reset-password",
    "db:copy-from-postgres": "tsx src/db/copy-from-postgres.ts"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.5",
    "morgan": "^1.12.1",
    "prisma": "^7.10.1",
    "socket.io": "^4.8.4",
    "zkteco-js": "^1.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.10",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
