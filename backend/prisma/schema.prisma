// MySQL schema for the BioTime attendance dashboard.
// Change this file, then run `npm run db:migrate:dev -- --name <what-changed>` to create a migration.
//
// Time convention: DATETIME columns hold the local wall-clock time used by BioTime
// ("2026-11-25 08:30:00"), not UTC. See src/db/time.ts for the conversion helpers.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  admin
  viewer
}

enum SyncJob {
  devices
  employees
  punches
  /// Punches read directly from devices over TCP/UDP 4370 (zkteco-js)
  device_punches
}

/// Where a punch came from
enum PunchSource {
  biotime
  device
}

enum SyncTrigger {
  startup
  schedule
  manual
  personnel_change
  range
}

enum RunStatus {
  running
  success
  failed
}

enum DeliveryStatus {
  pending
  success
  failed
}

/// People who can sign in to the dashboard.
model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique @db.VarChar(64)
  fullName     String?    @map("full_name") @db.VarChar(128)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(viewer)
  isActive     Boolean    @default(true) @map("is_active")
  lastLoginAt  DateTime?  @map("last_login_at") @db.DateTime(0)
  createdAt    DateTime   @map("created_at") @db.DateTime(0)
  updatedAt    DateTime   @map("updated_at") @db.DateTime(0)
  auditLogs    AuditLog[]

  @@map("users")
}

/// Mirror of BioTime employees. `id` is the BioTime id.
model Employee {
  id             Int      @id
  empCode        String   @map("emp_code") @db.VarChar(32)
  firstName      String?  @map("first_name") @db.VarChar(100)
  lastName       String?  @map("last_name") @db.VarChar(100)
  departmentId   Int?     @map("department_id")
  departmentName String?  @map("department_name") @db.VarChar(128)
  positionId     Int?     @map("position_id")
  positionName   String?  @map("position_name") @db.VarChar(128)
  /// Area ids (JSON array), set when areas are managed here instead of BioTime
  areaIds        Json?    @map("area_ids")
  areaNames      String?  @map("area_names") @db.VarChar(512)
  cardNo         String?  @map("card_no") @db.VarChar(32)
  mobile         String?  @db.VarChar(32)
  email          String?  @db.VarChar(128)
  gender         String?  @db.VarChar(8)
  hireDate       String?  @map("hire_date") @db.VarChar(10)
  enableAtt      Boolean  @default(true) @map("enable_att")
  /// PIN typed on the device (sent to devices when BioTime is off)
  devicePassword String?  @map("device_password") @db.VarChar(8)
  /// Device role: 0 employee, 2 enroller, 6 administrator, 14 super administrator
  devPrivilege   Int      @default(0) @map("dev_privilege") @db.SmallInt
  /// Created in this dashboard (not read from a device): device syncs never mark it deleted
  createdInApp   Boolean  @default(false) @map("created_in_app")
  isDeleted      Boolean  @default(false) @map("is_deleted")
  syncedAt       DateTime @map("synced_at") @db.DateTime(0)

  @@index([empCode])
  @@index([departmentId])
  @@map("employees")
}

/// Mirror of BioTime terminals. `id` is the BioTime id.
model Device {
  id               Int       @id
  sn               String    @db.VarChar(64)
  alias            String?   @db.VarChar(128)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  state            Int?      @db.SmallInt
  areaName         String?   @map("area_name") @db.VarChar(128)
  fwVer            String?   @map("fw_ver") @db.VarChar(64)
  lastActivity     DateTime? @map("last_activity") @db.DateTime(0)
  userCount        Int?      @map("user_count")
  fpCount          Int?      @map("fp_count")
  faceCount        Int?      @map("face_count")
  transactionCount Int?      @map("transaction_count")
  syncedAt         DateTime  @map("synced_at") @db.DateTime(0)

  @@index([sn])
  @@map("devices")
}

/// Every punch. For BioTime punches `id` is the BioTime transaction id, so re-syncing never duplicates.
/// Punches read directly from a device get negative ids, and are replaced by the BioTime row when BioTime
/// later reports the same punch (same emp_code, punch_time and terminal_sn).
model Punch {
  id            Int         @id
  source        PunchSource @default(biotime)
  empCode       String      @map("emp_code") @db.VarChar(32)
  punchTime     DateTime    @map("punch_time") @db.DateTime(0)
  punchState    String?     @map("punch_state") @db.VarChar(8)
  verifyType    Int?        @map("verify_type") @db.SmallInt
  workCode      String?     @map("work_code") @db.VarChar(32)
  terminalSn    String?     @map("terminal_sn") @db.VarChar(64)
  terminalAlias String?     @map("terminal_alias") @db.VarChar(128)
  areaAlias     String?     @map("area_alias") @db.VarChar(128)
  uploadTime    DateTime?   @map("upload_time") @db.DateTime(0)
  /// The sync run that first saved this punch
  syncRunId     Int?        @map("sync_run_id")
  syncedAt      DateTime    @map("synced_at") @db.DateTime(0)
  syncRun       SyncRun?    @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@index([punchTime])
  @@index([empCode, punchTime])
  @@index([terminalSn, punchTime])
  @@index([syncRunId])
  @@map("punches")
}

/// One row per sync job execution: what was fetched, what was new, how long, and any error.
model SyncRun {
  id                Int               @id @default(autoincrement())
  job               SyncJob
  trigger           SyncTrigger
  status            RunStatus         @default(running)
  startedAt         DateTime          @map("started_at") @db.DateTime(0)
  finishedAt        DateTime?         @map("finished_at") @db.DateTime(0)
  durationMs        Int?              @map("duration_ms")
  /// Records received from BioTime
  fetched           Int               @default(0)
  /// Records that were new to the database
  created           Int               @default(0)
  /// Existing records refreshed
  updated           Int               @default(0)
  /// Records removed or marked deleted
  removed           Int               @default(0)
  /// Time window read from BioTime (punches only)
  rangeFrom         DateTime?         @map("range_from") @db.DateTime(0)
  rangeTo           DateTime?         @map("range_to") @db.DateTime(0)
  /// Incremental punch sync continues from here on the next run
  cursorAt          DateTime?         @map("cursor_at") @db.DateTime(0)
  /// Webhook deliveries queued by this run
  webhooksQueued    Int               @default(0) @map("webhooks_queued")
  error             String?           @db.Text
  punches           Punch[]
  webhookDeliveries WebhookDelivery[]

  @@index([job, status, startedAt])
  @@index([startedAt])
  @@map("sync_runs")
}

/// Who did what (sign-ins, edits, deletes, manual syncs, webhook changes).
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  username  String?  @db.VarChar(64)
  action    String   @db.VarChar(32)
  entity    String   @db.VarChar(32)
  entityId  String?  @map("entity_id") @db.VarChar(64)
  summary   String?  @db.VarChar(255)
  details   Json?
  ip        String?  @db.VarChar(64)
  createdAt DateTime @map("created_at") @db.DateTime(0)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

/// An outgoing webhook: new punches and sync results are POSTed to `url`.
model Webhook {
  id             Int               @id @default(autoincrement())
  name           String            @db.VarChar(100)
  url            String            @db.VarChar(2048)
  /// HMAC-SHA256 signing secret (sent as X-Webhook-Signature)
  secret         String            @db.VarChar(128)
  /// Subscribed events, e.g. ["punch.created", "sync.failed"]
  events         Json
  isActive       Boolean           @default(true) @map("is_active")
  lastDeliveryAt DateTime?         @map("last_delivery_at") @db.DateTime(0)
  lastStatus     DeliveryStatus?   @map("last_status")
  createdAt      DateTime          @map("created_at") @db.DateTime(0)
  updatedAt      DateTime          @map("updated_at") @db.DateTime(0)
  deliveries     WebhookDelivery[]

  @@map("webhooks")
}

/// Every webhook request, including retries, so nothing is lost and failures can be re-sent.
model WebhookDelivery {
  id             Int            @id @default(autoincrement())
  webhookId      Int            @map("webhook_id")
  syncRunId      Int?           @map("sync_run_id")
  event          String         @db.VarChar(64)
  payload        Json
  status         DeliveryStatus @default(pending)
  attempts       Int            @default(0)
  nextAttemptAt  DateTime?      @map("next_attempt_at") @db.DateTime(0)
  responseStatus Int?           @map("response_status")
  responseBody   String?        @map("response_body") @db.Text
  error          String?        @db.Text
  durationMs     Int?           @map("duration_ms")
  createdAt      DateTime       @map("created_at") @db.DateTime(0)
  deliveredAt    DateTime?      @map("delivered_at") @db.DateTime(0)
  webhook        Webhook        @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  syncRun        SyncRun?       @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

/// How the server talks to a device.
enum DeviceMode {
  /// The server connects to the device over the network (TCP, falling back to UDP, port 4370)
  pull
  /// The device sends punches to this server (ADMS / "Cloud Server Setting")
  push
  /// Both: pushes arrive live and the server also reads the device to catch anything missed
  both
}

/// Attendance devices, managed on the Settings page.
model ZkDevice {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(100)
  mode         DeviceMode @default(pull)
  /// Needed for pull / both
  ip           String?    @db.VarChar(64)
  port         Int        @default(4370)
  /// Needed for push / both: pushes are matched by serial number
  serialNumber String?    @unique @map("serial_number") @db.VarChar(64)
  location     String?    @db.VarChar(128)
  /// Network timeout for this device
  timeoutMs    Int        @default(10000) @map("timeout_ms")
  /// Bytes per download chunk. Lower (e.g. 8184) for slow or remote links; null = library default
  chunkSize    Int?       @map("chunk_size")
  enabled      Boolean    @default(true)
  /// Filled in by "Test connection"
  model        String?    @db.VarChar(100)
  firmware     String?    @db.VarChar(100)
  lastSeenAt   DateTime?  @map("last_seen_at") @db.DateTime(0)
  /// ADMS: last operation-log stamp the device reported, so it doesn't re-send old users/templates
  operlogStamp String?    @map("operlog_stamp") @db.VarChar(32)
  createdAt    DateTime   @map("created_at") @db.DateTime(0)
  updatedAt    DateTime   @map("updated_at") @db.DateTime(0)
  commands     DeviceCommand[]

  @@map("zk_devices")
}

/// Settings edited on the Settings page (BioTime, ADMS, sync). One row per key; values are JSON.
model AppSetting {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @map("updated_at") @db.DateTime(0)

  @@map("app_settings")
}

enum OrgUnitKind {
  department
  area
  position
}

/// Departments, areas and positions managed in this dashboard (used when BioTime is off).
model OrgUnit {
  id        Int         @id @default(autoincrement())
  kind      OrgUnitKind
  code      String      @db.VarChar(50)
  name      String      @db.VarChar(100)
  parentId  Int?        @map("parent_id")
  createdAt DateTime    @map("created_at") @db.DateTime(0)
  updatedAt DateTime    @map("updated_at") @db.DateTime(0)

  @@unique([kind, code])
  @@index([kind])
  @@map("org_units")
}

enum CommandStatus {
  /// Waiting: push devices pick it up at their next poll, pull devices are connected to by the server
  pending
  /// Handed to a push device; waiting for its reply
  sent
  success
  failed
  cancelled
}

/// How a command reaches the device
enum CommandChannel {
  /// The device polls /iclock/getrequest (ADMS) and reports back on /iclock/devicecmd
  push
  /// The server connects to the device (TCP/UDP 4370)
  pull
}

/// Work for a device: add/remove users, copy fingerprints/faces, fetch punches or users, enroll, reboot.
model DeviceCommand {
  id            Int            @id @default(autoincrement())
  deviceId      Int            @map("device_id")
  channel       CommandChannel
  /// user_upsert, user_delete, template_upsert, enroll_fp, query_attlog, query_users, reboot, check
  kind          String         @db.VarChar(32)
  /// ADMS command text sent to push devices (without the "C:<id>:" prefix); a description for pull
  command       String         @db.MediumText
  /// What a pull command needs to run
  payload       Json?
  empCode       String?        @map("emp_code") @db.VarChar(32)
  status        CommandStatus  @default(pending)
  attempts      Int            @default(0)
  /// Pull commands that failed to connect are retried from this time
  nextAttemptAt DateTime?      @map("next_attempt_at") @db.DateTime(0)
  /// The device's Return= code (0 = success, negative = error)
  returnCode    Int?           @map("return_code")
  result        String?        @db.MediumText
  createdBy     String?        @map("created_by") @db.VarChar(64)
  createdAt     DateTime       @map("created_at") @db.DateTime(0)
  sentAt        DateTime?      @map("sent_at") @db.DateTime(0)
  completedAt   DateTime?      @map("completed_at") @db.DateTime(0)
  device        ZkDevice       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status, id])
  @@index([empCode, id])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@map("device_commands")
}

/// Fingerprint and face templates uploaded by devices after enrollment, copied to the other devices.
model BiometricTemplate {
  id        Int      @id @default(autoincrement())
  empCode   String   @map("emp_code") @db.VarChar(32)
  /// 1 fingerprint, 2 face (near-infrared), 8 palm, 9 face (visible light)
  bioType   Int      @map("bio_type") @db.SmallInt
  /// Finger number 0-9 (0 for faces)
  bioIndex  Int      @map("bio_index") @db.SmallInt
  /// Part number for templates stored in several parts (older faces)
  subIndex  Int      @default(0) @map("sub_index") @db.SmallInt
  /// Device table it came from, used to send it back the same way: FINGERTMP | FACE | BIODATA
  format    String   @db.VarChar(16)
  /// The record's other fields in device order, as [key, value] pairs
  fields    Json
  /// Name of the template field (TMP or Tmp)
  tmpKey    String   @default("TMP") @map("tmp_key") @db.VarChar(8)
  template  String   @db.MediumText
  sourceSn  String?  @map("source_sn") @db.VarChar(64)
  createdAt DateTime @map("created_at") @db.DateTime(0)
  updatedAt DateTime @map("updated_at") @db.DateTime(0)

  @@unique([empCode, bioType, bioIndex, subIndex])
  @@index([empCode])
  @@map("biometric_templates")
}
