# ZK Attendance dashboard (Next.js): frontend/.env

# Port and address the dashboard runs on (open http://localhost:<PORT>)
PORT=3000
# 0.0.0.0 = reachable from other PCs and phones on the network; 127.0.0.1 = this computer only
HOST=0.0.0.0

# Where the backend API runs, as seen from this server (same machine = localhost).
# Must match PORT in backend/.env. Read at "npm run build": rebuild after changing it.
BACKEND_URL=http://localhost:4000
